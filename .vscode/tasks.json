{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Docker Databases",
      "type": "shell",
      "command": "docker compose up -d",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "panel": "shared",
        "echo": true,
        "reveal": "always",
        "focus": false
      }
    },
    {
      "label": "Stop Docker Databases",
      "type": "shell",
      "command": "docker compose down",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "panel": "shared",
        "echo": true,
        "reveal": "always",
        "focus": false
      }
    },
    {
      "label": "Start Backend",
      "type": "shell",
      "command": "npm install; npm run start:dev",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "echo": true,
        "reveal": "always",
        "focus": false
      }
    },
    {
      "label": "Start Frontend",
      "type": "shell",
      "command": "npm install; npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "echo": true,
        "reveal": "always",
        "focus": false
      }
    },
    {
      "label": "Start All",
      "dependsOrder": "parallel",
      "dependsOn": ["Start Docker Databases", "Start Backend", "Start Frontend"],
      "problemMatcher": []
    }
  ]
}
